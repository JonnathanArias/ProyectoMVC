@model SistemaInventario.Modelos.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
}

<h2>@ViewData["Title"]</h2>
<hr />

<div class="row">
    <div class="col-md-12">
        <form asp-action="Editar" method="post">
            @await Html.PartialAsync("_FormularioUsuario", Model)
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}